# .env.example — 提交到 Git，真实值写在 .env（已 gitignore）

# companion-api 内省端点(验证 cms 传来的 SSO token,portal 不持密钥)
COMPANION_API_BASE=https://api.xingyu.pro/v1/companion

# 本 cms 工具的 slug(面板注册时用;内省后判断 managedTools 是否含它)
CMS_TOOL_SLUG=portal-cms

# 总台审计上报服务令牌(配了才把发布事件上报到 ops 统一审计流;留空=只用本地审计)
# 真实值向总台 companion-api 取,写在 .env(勿入 git)
AUDIT_REPORT_TOKEN=
